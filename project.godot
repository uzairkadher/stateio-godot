; Engine configuration file.
; Pinned target version: Godot 4.3.stable

config_version=5

[application]

config/name="Territory Capture (State.io-Style Recreation)"
config/description="Independent Godot 4.3 territory-capture strategy game — Milestone 1 Scaffold"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

